        <mxCell id="e5" style="endArrow=classic;html=1;strokeWidth=1.6;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="v0" style="endArrow=classic;html=1;strokeWidth=1.2;strokeColor=#999999;" edge="1" parent="1" source="p0" target="g0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v1" style="endArrow=classic;html=1;strokeWidth=1.2;strokeColor=#999999;" edge="1" parent="1" source="p1" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v2" style="endArrow=classic;html=1;strokeWidth=1.2;strokeColor=#999999;" edge="1" parent="1" source="p2" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v3" style="endArrow=classic;html=1;strokeWidth=1.2;strokeColor=#999999;" edge="1" parent="1" source="p3" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
