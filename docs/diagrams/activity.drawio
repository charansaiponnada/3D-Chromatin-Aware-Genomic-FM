        <mxCell id="f8" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="a4" target="fork"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" style="endArrow=classic;html=1;strokeWidth=1.5;exitX=0.13;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork" target="b_full"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="endArrow=classic;html=1;strokeWidth=1.5;exitX=0.53;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork" target="b_ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="endArrow=classic;html=1;strokeWidth=1.5;exitX=0.87;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork" target="b_seed"><mxGeometry relative="1" as="geometry" /></mxCell>
