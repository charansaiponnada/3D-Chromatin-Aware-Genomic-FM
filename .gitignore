# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Data ------------------------------------------------------------------
# Git carries CODE + the manifest. The cluster rebuilds the data from
# data/manifest.json with `python scripts/build_data.py`. Nothing under
# data/raw or data/processed is transferable and none of it belongs in git.
data/raw/
data/interim/
data/processed/
*.fa
*.fa.gz
*.fai
*.mcool
*.cool
*.hic
*.part

# ...but the manifest and the QC reports ARE tracked. A number the paper
# quotes has to live in a file git carries. They are a few kB each.
!data/manifest.json
!data/**/*_qc.json

# --- Results ---------------------------------------------------------------
# Checkpoints are ~100 MB each; GitHub warns above 50 MB and history is
# permanent. Every claim traces to metrics.json + run_config.yaml instead,
# which ARE tracked. Weights are reproducible from the logged seed + config.
results/**/*.pt
results/**/*.ckpt
results/**/*.pid
results/**/*.lock
results/**/*.tmp
wandb/
mlruns/

# --- LaTeX build artefacts ---------------------------------------------
# The .tex source and the compiled .pdf are tracked; the intermediates are not.
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# probe output is machine-specific
env_probe.json
